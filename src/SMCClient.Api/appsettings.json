{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "SMCClient": "Server=.;Database=SMCClient;Integrated Security=true;TrustServerCertificate=true;Application Name=SMCClient.Api"
  },
  "Seguridad": {
    "Autenticacion": "Windows",
    "GruposLectura": [],
    "GruposAdmin": [ "DOMINIO\\SMC-Administradores" ]
  },
  "Api": {
    "SegundosCacheMetadatos": 30,
    "SegundosCacheEstadoSync": 5,
    "TimeoutSqlSegundos": 60,
    "MaxFilas": 10000,
    "ParametrosDeUsuario": [ "SolicitadoPor" ],
    "HospedarWorker": false
  }
}
