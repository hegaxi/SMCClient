# Copia este archivo como .env (ignorado por git) y llena los valores. Nunca subas el .env.
# Cuenta de Jira Cloud y token de API (https://id.atlassian.com/manage-profile/security/api-tokens)
JIRA_USUARIO=
JIRA_TOKEN=
# Administrador inicial de la aplicación web
SMC_ADMIN_USUARIO=
SMC_ADMIN_CONTRASENA=
# Cadena de conexión a SQL Server, p. ej. Server=.;Database=SMCClient;Integrated Security=true;TrustServerCertificate=true
SMC_CADENA_SQL=
